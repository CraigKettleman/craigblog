/node_modules

# SvelteKit / Vite
/.svelte-kit
/build
vite.config.ts.timestamp-*

# Velite (generated content data + copied assets)
# 数据目录与软链接：正式入口是 .velite / static/blog，真实内容放在 -a/-b 两个槽位里轮换，
# .swap 是原子换入用的临时软链接
/.velite
/.velite-a
/.velite-b
/.velite.swap
/static/blog
/static/blog-a
/static/blog-b
/static/blog.swap

# misc
.DS_Store
*.pem
*.log
*.tsbuildinfo

# 本地访问统计数据（真实事件，不入库）
/data

# local env files
.env
.env.*
!.env.example
